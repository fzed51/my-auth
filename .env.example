# Variables d'environnement pour MyAuth

# =============================================================================
# CONFIGURATION DE L'APPLICATION
# =============================================================================

# Environnement de l'application (development, testing, production)
APP_ENV=development

# Nom de l'application
APP_NAME="MyAuth API"

# Version de l'application
APP_VERSION=1.0.0

# URL de base de l'application
APP_URL=http://localhost:8080

# Mode debug (true/false)
APP_DEBUG=true

# =============================================================================
# CONFIGURATION DE LA BASE DE DONNÉES
# =============================================================================

# Type de base de données
DB_DRIVER=mysql

# Hôte de la base de données
DB_HOST=localhost

# Port de la base de données
DB_PORT=3306

# Nom de la base de données
DB_NAME=myauth_db

# Nom d'utilisateur de la base de données
DB_USER=myauth_user

# Mot de passe de la base de données
DB_PASSWORD=myauth_secure_password

# Charset de la base de données
DB_CHARSET=utf8mb4

# Collation de la base de données
DB_COLLATION=utf8mb4_unicode_ci

# =============================================================================
# CONFIGURATION DE LA BASE DE DONNÉES DE TEST
# =============================================================================

# Base de données de test
DB_TEST_NAME=myauth_test_db
DB_TEST_USER=myauth_test_user
DB_TEST_PASSWORD=myauth_test_password

# =============================================================================
# CONFIGURATION JWT
# =============================================================================

# Clé secrète pour signer les tokens JWT
# IMPORTANT: Changez cette clé en production avec une valeur longue et aléatoire
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-256-bits

# Algorithme de chiffrement JWT
JWT_ALGORITHM=HS256

# Durée de vie des tokens d'accès (en secondes) - 15 minutes
JWT_ACCESS_TTL=900

# Durée de vie des tokens de rafraîchissement (en secondes) - 7 jours
JWT_REFRESH_TTL=604800

# Issuer des tokens JWT
JWT_ISSUER=myauth-api

# Audience des tokens JWT
JWT_AUDIENCE=myauth-clients

# =============================================================================
# CONFIGURATION DE L'EMAIL
# =============================================================================

# Configuration SMTP pour l'envoi d'emails
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_ENCRYPTION=tls

# Adresse email d'expédition
MAIL_FROM_ADDRESS=noreply@myauth.local
MAIL_FROM_NAME="MyAuth Service"

# =============================================================================
# CONFIGURATION DE LA SÉCURITÉ
# =============================================================================

# Durée de vie des tokens de vérification d'email (en heures) - 24 heures
EMAIL_VERIFICATION_TTL=24

# Nombre maximum de tentatives de connexion par IP - 5 tentatives
MAX_LOGIN_ATTEMPTS=5

# Durée de blocage après échec de connexion (en minutes) - 15 minutes
LOGIN_LOCKOUT_TIME=15

# Longueur minimale des mots de passe
MIN_PASSWORD_LENGTH=8

# =============================================================================
# CONFIGURATION DU RATE LIMITING
# =============================================================================

# Limite de requêtes par minute pour les endpoints d'authentification
AUTH_RATE_LIMIT=10

# Limite de requêtes par minute pour les endpoints généraux
API_RATE_LIMIT=60

# =============================================================================
# CONFIGURATION DES LOGS
# =============================================================================

# Niveau de log (emergency, alert, critical, error, warning, notice, info, debug)
LOG_LEVEL=info

# Canal de log (file, stdout, syslog)
LOG_CHANNEL=file

# Chemin du fichier de log
LOG_PATH=../var/logs/app.log

# =============================================================================
# CONFIGURATION DU CACHE
# =============================================================================

# Driver de cache (file, redis, memcached)
CACHE_DRIVER=file

# Chemin du cache fichier
CACHE_PATH=../var/cache

# =============================================================================
# CONFIGURATION REDIS (si utilisé)
# =============================================================================

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# =============================================================================
# CONFIGURATION DE DÉVELOPPEMENT
# =============================================================================

# Activation du mode de débogage détaillé
DEVELOPMENT_MODE=true

# Affichage des erreurs PHP
DISPLAY_ERRORS=true

# Niveau de rapport d'erreur PHP
ERROR_REPORTING=E_ALL

# =============================================================================
# CONFIGURATION DES CORS
# =============================================================================

# Origines autorisées pour CORS (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Méthodes HTTP autorisées
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# Headers autorisés
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-API-Key,X-Requested-With,Accept,Origin

# Credentials autorisés
CORS_ALLOW_CREDENTIALS=true
