{
    "name": "my-auth/service",
    "description": "Service d'authentification sécurisé",
    "type": "project",
    "require": {
        "php": "^8.0",
        "firebase/php-jwt": "^6.0",
        "php-di/php-di": "^6.4",
        "php-di/slim-bridge": "^3.4",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.0",
        "vlucas/phpdotenv": "^5.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.6",
        "phpstan/phpstan": "^1.8",
        "nikic/php-parser": "^5.6.0"
    },
    "autoload": {
        "psr-4": {
            "MyAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MyAuth\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" ./vendor/bin/phpunit",
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "stan": "phpstan analyse src/ --level=max --memory-limit=512M",
        "scan-long-lines": "php bin/scan-long-lines.php",
        "auto-format": "php bin/auto-format.php",
        "format": "php bin/format-php.php",
        "quality": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
