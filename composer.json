{
    "name": "my-auth/service",
    "description": "Service d'authentification sécurisé",
    "type": "project",
    "require": {
        "php": "^8.0",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^6.4",
        "firebase/php-jwt": "^6.0",
        "swiftmailer/swiftmailer": "^6.3",
        "vlucas/phpdotenv": "^5.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.6",
        "phpstan/phpstan": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "MyAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MyAuth\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs --standard=PSR12 src/",
        "cs-fix": "phpcbf --standard=PSR12 src/",
        "stan": "phpstan analyse src/ --level=max",
        "quality": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
